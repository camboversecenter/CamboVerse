# Downloaded/executed notebooks may embed outputs, private paths or signed URLs.
# Reviewed output-free training templates remain versionable.
/notebooks/*original*.ipynb
/notebooks/*executed*.ipynb
/notebooks/clock-cell-*.py
/notebooks/clock_setup_kaggle.py
/notebooks/clock_render_review_kaggle.py
/wat-phnom-clock-kaggle-proof.png

