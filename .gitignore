# Local-only test assets - a place to evaluate external models WITHOUT
# committing them (e.g. license-restricted models under review). Never commit
# assets here; only their own models / openly-licensed ones enter the repo.
public/models/local/*
!public/models/local/README.md

# build-only font cache for glyph-path extraction
scripts/.fontcache/
scripts/.stroke-preview.html

# Internal stroke-order authoring tool - not part of the app, never commit
public/stroke-editor.html

# Internal monument-layout authoring tool - not part of the app, never commit
public/monument-editor.html

# Private room reconstruction experiment and its project-local runtime.
output/room-alignment-v1/
.codex-tools/room-recon/
.codex-tools/openmvs/
output/room-mesh-v1/

# Local agent runtimes/settings, diagnostics and downloaded reference material.
# Keep reusable project source in scripts/, docs/ and src/ instead.
/.codex-tools/
/.codex/
/.claude/
/output/
/tmp/
/temp/

# Private capture/training inputs and authoring intermediates. Public release
# needs a separate provenance/privacy review; ignoring never deletes local data.
