# Dependencies
node_modules/

# Build output
dist/
.wrangler/

# Vite / TS
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Env / secrets
.dev.vars
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Local-only test assets — a place to evaluate external models WITHOUT
# committing them (e.g. license-restricted models under review). Never commit
# assets here; only their own models / openly-licensed ones enter the repo.
public/models/local/*
!public/models/local/README.md

# build-only font cache for glyph-path extraction
scripts/.fontcache/
scripts/.stroke-preview.html

# Internal stroke-order authoring tool — not part of the app, never commit
public/stroke-editor.html

# Letter pronunciation feature — work in progress, not wired into the app
# yet (paused mid-verification). Keep the generated clips + generator script
# on disk for later, but don't let them slip into a commit until it's done.
public/audio/
scripts/generate-audio.mjs
